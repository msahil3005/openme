<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<!-- Mobile-friendly viewport, important for iPhone Safari -->
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>A Question for Sadiya 🧡</title>
<style>
  :root {
    --pink-light: #ffe4ec;
    --pink-mid: #ffc2d9;
    --white: #ffffff;
    --accent: #ff7fa5;
    --orange: #ff9a56;
    --text-dark: #5c3a4a;
  }

  * {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
  }

  html, body {
    height: 100%;
    margin: 0;
    overflow-x: hidden;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: linear-gradient(135deg, var(--pink-light), var(--white) 60%, var(--pink-mid));
    background-size: 200% 200%;
    animation: gradientShift 12s ease infinite;
    min-height: 100vh;
    min-height: 100dvh; /* iPhone Safari safe */
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 20px;
    padding-top: max(20px, env(safe-area-inset-top));
    padding-bottom: max(20px, env(safe-area-inset-bottom));
  }

  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* Floating background hearts */
  .bg-hearts {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .bg-heart {
    position: absolute;
    bottom: -10%;
    font-size: 20px;
    opacity: 0.35;
    animation: floatUp linear infinite;
    color: var(--accent);
    user-select: none;
  }

  @keyframes floatUp {
    0% {
      transform: translateY(0) rotate(0deg);
      opacity: 0;
    }
    10% { opacity: 0.4; }
    90% { opacity: 0.4; }
    100% {
      transform: translateY(-115vh) rotate(360deg);
      opacity: 0;
    }
  }

  /* Main card */
  .card {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 28px;
    padding: 40px 28px;
    max-width: 420px;
    width: 100%;
    text-align: center;
    box-shadow: 0 20px 60px rgba(255, 127, 165, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.6);
    animation: cardIn 0.8s ease-out;
  }

  @keyframes cardIn {
    from { opacity: 0; transform: translateY(30px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .title {
    font-size: 24px;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 18px;
    line-height: 1.4;
  }

  .question {
    font-size: 20px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 16px;
    line-height: 1.4;
  }

  .subtext {
    font-size: 15px;
    color: var(--text-dark);
    opacity: 0.85;
    line-height: 1.6;
    margin-bottom: 32px;
  }

  /* Button area - relative container so NO button can roam freely */
  .button-area {
    position: relative;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }

  button {
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-weight: 700;
    font-size: 17px;
    border-radius: 50px;
    padding: 14px 32px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    -webkit-user-select: none;
    user-select: none;
  }

  #yesBtn {
    background: linear-gradient(135deg, var(--orange), var(--accent));
    color: white;
    box-shadow: 0 8px 20px rgba(255, 127, 165, 0.4);
    z-index: 3;
  }

  #yesBtn:active {
    transform: scale(0.95);
  }

  #noBtn {
    background: white;
    color: var(--text-dark);
    border: 2px solid var(--pink-mid);
    position: absolute;
    /* transform-based movement is buttery smooth on iOS */
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 2;
  }

  /* Success screen */
  .success-screen {
    display: none;
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 28px;
    padding: 48px 28px;
    max-width: 420px;
    width: 100%;
    text-align: center;
    box-shadow: 0 20px 60px rgba(255, 127, 165, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.6);
    animation: cardIn 0.8s ease-out;
  }

  .success-screen.visible {
    display: block;
  }

  .success-emoji {
    font-size: 56px;
    margin-bottom: 18px;
    animation: pop 0.6s ease-out;
  }

  @keyframes pop {
    0% { transform: scale(0); }
    60% { transform: scale(1.2); }
    100% { transform: scale(1); }
  }

  .success-title {
    font-size: 22px;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 14px;
    line-height: 1.4;
  }

  .success-subtext {
    font-size: 15px;
    color: var(--text-dark);
    opacity: 0.85;
    line-height: 1.6;
  }

  /* Celebration hearts burst on success */
  .celebrate-hearts {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 5;
    overflow: hidden;
  }

  .celebrate-heart {
    position: absolute;
    font-size: 24px;
    animation: celebrateFloat 3s ease-in forwards;
  }

  @keyframes celebrateFloat {
    0% {
      transform: translateY(0) scale(0.5) rotate(0deg);
      opacity: 1;
    }
    100% {
      transform: translateY(-100vh) scale(1.2) rotate(360deg);
      opacity: 0;
    }
  }

  @media (max-width: 380px) {
    .card, .success-screen { padding: 32px 20px; }
    .title { font-size: 21px; }
    .question { font-size: 18px; }
    button { font-size: 15px; padding: 12px 26px; }
  }
</style>
</head>
<body>

<!-- Ambient floating hearts in the background -->
<div class="bg-hearts" id="bgHearts"></div>

<!-- Main question card -->
<div class="card" id="mainCard">
  <div class="title">Sadiya, can I ask you something? 🥺🧡</div>
  <div class="question">Will you add me back on Instagram?</div>
  <div class="subtext">
    I promise I won't do it again. I know I messed up, and I just want one chance to make things right. 🧡
  </div>

  <div class="button-area" id="buttonArea">
    <button id="yesBtn">YES 🧡</button>
    <button id="noBtn">NO 😭</button>
  </div>
</div>

<!-- Success screen, hidden until YES is pressed -->
<div class="success-screen" id="successScreen">
  <div class="success-emoji">😭🧡</div>
  <div class="success-title">I knew you had it in you 😭🧡</div>
  <div class="success-subtext">
    Thank you, Sadiya. I promise I'll respect this chance and I won't do the same thing again. 🥹
  </div>
</div>

<!-- Container for the big heart burst on success -->
<div class="celebrate-hearts" id="celebrateHearts"></div>

<script>
  // ---------- Background ambient hearts ----------
  const bgHeartsContainer = document.getElementById('bgHearts');
  const heartEmojis = ['🧡', '💕', '💗', '❤️'];

  function spawnBgHeart() {
    const heart = document.createElement('div');
    heart.className = 'bg-heart';
    heart.textContent = heartEmojis[Math.floor(Math.random() * heartEmojis.length)];
    heart.style.left = Math.random() * 100 + 'vw';
    heart.style.fontSize = (14 + Math.random() * 16) + 'px';
    const duration = 8 + Math.random() * 6;
    heart.style.animationDuration = duration + 's';
    bgHeartsContainer.appendChild(heart);
    // Clean up after animation finishes so the DOM doesn't grow forever
    setTimeout(() => heart.remove(), duration * 1000);
  }

  // Spawn a gentle stream of ambient hearts
  setInterval(spawnBgHeart, 900);
  for (let i = 0; i < 6; i++) setTimeout(spawnBgHeart, i * 300);

  // ---------- Runaway NO button ----------
  const noBtn = document.getElementById('noBtn');
  const yesBtn = document.getElementById('yesBtn');
  const buttonArea = document.getElementById('buttonArea');

  // Move the NO button to a random safe position within its container
  function moveNoButton() {
    const areaRect = buttonArea.getBoundingClientRect();
    const btnRect = noBtn.getBoundingClientRect();

    // Padding so the button never touches the very edge
    const padding = 8;

    const maxX = areaRect.width - btnRect.width - padding;
    const maxY = areaRect.height - btnRect.height - padding;

    // Random position within safe bounds (never negative)
    const randX = padding + Math.random() * Math.max(maxX - padding, 0);
    const randY = padding + Math.random() * Math.max(maxY - padding, 0);

    // Position is relative to the button's current CSS position (static center),
    // so we calculate an offset via transform for smooth animation.
    const currentRect = noBtn.getBoundingClientRect();
    const areaOrigin = buttonArea.getBoundingClientRect();

    // Compute where the button currently sits relative to the container
    const currentLeft = currentRect.left - areaOrigin.left;
    const currentTop = currentRect.top - areaOrigin.top;

    // On first move, button is centered via flex; lock it to absolute pixel position first
    if (!noBtn.dataset.locked) {
      noBtn.style.left = currentLeft + 'px';
      noBtn.style.top = currentTop + 'px';
      noBtn.style.margin = '0';
      noBtn.dataset.locked = 'true';
    }

    noBtn.style.left = randX + 'px';
    noBtn.style.top = randY + 'px';
  }

  // Desktop: move away when the mouse gets close
  buttonArea.addEventListener('mousemove', (e) => {
    const btnRect = noBtn.getBoundingClientRect();
    const btnCenterX = btnRect.left + btnRect.width / 2;
    const btnCenterY = btnRect.top + btnRect.height / 2;

    const dx = e.clientX - btnCenterX;
    const dy = e.clientY - btnCenterY;
    const distance = Math.sqrt(dx * dx + dy * dy);

    // If mouse is within 70px of the button's center, run away
    if (distance < 70) {
      moveNoButton();
    }
  });

  // Also dodge on direct click attempts (covers fast mouse movement)
  noBtn.addEventListener('mouseenter', moveNoButton);
  noBtn.addEventListener('click', (e) => {
    e.preventDefault();
    moveNoButton();
  });

  // Mobile: move away on touch/tap attempts
  noBtn.addEventListener('touchstart', (e) => {
    e.preventDefault();
    moveNoButton();
  }, { passive: false });

  // Recompute a safe position if the window is resized (orientation change etc.)
  window.addEventListener('resize', () => {
    if (noBtn.dataset.locked) moveNoButton();
  });

  // ---------- YES button behavior ----------
  yesBtn.addEventListener('click', showSuccessScreen);
  yesBtn.addEventListener('touchend', (e) => {
    e.preventDefault();
    showSuccessScreen();
  });

  let successShown = false;

  function showSuccessScreen() {
    if (successShown) return;
    successShown = true;

    const mainCard = document.getElementById('mainCard');
    const successScreen = document.getElementById('successScreen');

    mainCard.style.display = 'none';
    successScreen.classList.add('visible');

    burstCelebrationHearts();
  }

  // ---------- Celebration heart burst ----------
  function burstCelebrationHearts() {
    const container = document.getElementById('celebrateHearts');
    const total = 30;

    for (let i = 0; i < total; i++) {
      setTimeout(() => {
        const heart = document.createElement('div');
        heart.className = 'celebrate-heart';
        heart.textContent = heartEmojis[Math.floor(Math.random() * heartEmojis.length)];
        heart.style.left = Math.random() * 100 + 'vw';
        heart.style.bottom = '-40px';
        heart.style.fontSize = (18 + Math.random() * 22) + 'px';
        heart.style.animationDuration = (2.5 + Math.random() * 2) + 's';
        container.appendChild(heart);
        setTimeout(() => heart.remove(), 5000);
      }, i * 80);
    }

    // Keep a gentle ongoing sprinkle of hearts on the success screen
    setInterval(() => {
      const heart = document.createElement('div');
      heart.className = 'celebrate-heart';
      heart.textContent = heartEmojis[Math.floor(Math.random() * heartEmojis.length)];
      heart.style.left = Math.random() * 100 + 'vw';
      heart.style.bottom = '-40px';
      heart.style.fontSize = (16 + Math.random() * 18) + 'px';
      heart.style.animationDuration = (3 + Math.random() * 2) + 's';
      container.appendChild(heart);
      setTimeout(() => heart.remove(), 6000);
    }, 700);
  }
</script>

</body>
</html>
